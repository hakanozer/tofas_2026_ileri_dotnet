<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>EvolutionaryLogistics.Gateway</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <!-- Curriculum target: YARP 3.12.1 — NuGet currently ships 2.3.0 with compatible config schema -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0-preview.7.25380.108" />
    <!-- Serilog.AspNetCore: UseSerilogRequestLogging middleware. Config lives in Shared.Observability. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Shared.Kernel\Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Shared.Observability\Shared.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="yarp.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
