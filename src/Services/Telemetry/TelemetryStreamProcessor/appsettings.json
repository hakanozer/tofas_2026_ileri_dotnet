{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "EvolutionaryLogistics.Services.Telemetry": "Debug"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=evolutionary_logistics;Username=app;Password=app_secret_change_me"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "GroupId": "telemetry-stream-processor",
    "Topic": "telemetry.raw",
    "BatchSize": 500,
    "FlushIntervalMs": 1000,
    "ChannelCapacity": 32,
    "ProcessorConcurrency": 4
  }
}
